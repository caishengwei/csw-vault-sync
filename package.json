{
	"name": "csw-vault-sync",
	"version": "1.3.1",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"vault-sync": "dist/vault-sync.cjs"
	},
	"main": "main.js",
	"scripts": {
		"dev": "run-p dev:*",
		"dev:plugin": "node esbuild.config.mjs",
		"dev:remote-explorer": "pnpm --filter remote-explorer dev",
		"build": "run-s build:remote-explorer build:plugin build:node",
		"build:node": "node build-node.mjs",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"build:remote-explorer": "pnpm --filter remote-explorer build",
		"build:plugin": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && swc ./dist/main.js -o ./dist/main.js && cp manifest.json ./dist/manifest.json",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@deanc/esbuild-plugin-postcss": "^1.0.2",
		"@electron/remote": "^2.1.2",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@noble/hashes": "1.8.0",
		"@swc/cli": "^0.7.9",
		"@swc/core": "^1.15.6",
		"@types/diff-match-patch": "^1.0.36",
		"@types/glob-to-regexp": "^0.4.4",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^16.11.6",
		"@types/path-browserify": "^1.0.3",
		"@types/ramda": "^0.30.2",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"@unocss/postcss": "66.1.0-beta.3",
		"@vitest/coverage-v8": "^3.1.2",
		"assert": "^2.1.0",
		"async-mutex": "^0.5.0",
		"blob-polyfill": "^9.0.20240710",
		"bottleneck": "^2.19.5",
		"buffer": "^6.0.3",
		"builtin-modules": "3.3.0",
		"bytes-iec": "^3.1.1",
		"consola": "^3.4.0",
		"core-js": "^3.41.0",
		"crypto-browserify": "^3.12.1",
		"diff-match-patch": "^1.0.5",
		"dotenv": "^16.4.7",
		"esbuild": "0.17.3",
		"esbuild-sass-plugin": "^3.3.1",
		"fflate": "^0.8.2",
		"glob-to-regexp": "^0.4.1",
		"hash-wasm": "^4.12.0",
		"html-entities": "^2.6.0",
		"i18next": "^24.2.2",
		"js-base64": "^3.7.7",
		"localforage": "^1.10.0",
		"lodash-es": "^4.17.21",
		"node-diff3": "^3.1.2",
		"npm-run-all2": "^7.0.2",
		"obsidian": "1.12.3",
		"ohash": "^1.1.4",
		"path-browserify": "^1.0.1",
		"postcss-merge-rules": "^7.0.4",
		"prettier": "^3.5.0",
		"qrcode-generator": "2.0.4",
		"ramda": "^0.30.1",
		"remote-explorer": "workspace: *",
		"rxjs": "^7.8.1",
		"stream-browserify": "^3.0.0",
		"superjson": "^2.2.2",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"unocss": "66.1.0-beta.3",
		"uuid": "^13.0.0",
		"vitest": "^3.1.2",
		"zod": "3.25.76"
	},
	"browser": {
		"path": "path-browserify",
		"stream": "stream-browserify",
		"buffer": "buffer",
		"crypto": "crypto-browserify"
	}
}
